{
  "manifest_version": 3,
  "name": "WIRA-SHIELD Web Guard",
  "version": "1.0.0",
  "description": "Universal Web Click Interceptor — mencegah Silent Auto-Install (MITRE T1189) di semua situs. Demo defensif lokal, data hanya ke 127.0.0.1:5050.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5050/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WIRA-SHIELD Web Guard"
  }
}
